# Copiar a .env local (nunca versionar credenciales)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fleetlogix_db
PGUSER=postgres
# PGPASSWORD=   # Opcional: si se omite, algunos scripts solicitan clave en terminal.

# Snowflake: obtén ACCOUNT con CURRENT_ORGANIZATION_NAME() y CURRENT_ACCOUNT_NAME()
SNOWFLAKE_ACCOUNT=tu-organizacion-tu-cuenta
SNOWFLAKE_USER=tu-usuario
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=FLEETLOGIX_WH
SNOWFLAKE_DATABASE=FLEETLOGIX_DWH
SNOWFLAKE_SCHEMA=ANALYTICS

# Los scripts de la entrega usan OAuth interactivo de navegador.
# NO guardar tokens OAuth, AWS_SECRET_ACCESS_KEY ni claves privadas en Git.
